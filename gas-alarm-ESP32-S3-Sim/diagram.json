{
  "version": 1,
  "author": "gas-alarm-sim",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-gas-sensor", "id": "mq2", "top": -150, "left": -200, "attrs": {} },
    { "type": "wokwi-buzzer", "id": "bz", "top": -130, "left": 150, "attrs": { "volume": "0.1" } },
    { "type": "wokwi-rgb-led", "id": "rgb", "top": 120, "left": 220, "attrs": { "common": "cathode" } },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 230, "left": -120, "attrs": { "color": "green" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "mq2:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "mq2:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "mq2:AOUT", "esp:1", "orange", [ "v0" ] ],

    [ "bz:1", "esp:GND.1", "black", [ "v0" ] ],
    [ "bz:2", "esp:4", "purple", [ "v0" ] ],

    [ "rgb:R", "esp:5", "red", [ "v0" ] ],
    [ "rgb:G", "esp:6", "green", [ "v0" ] ],
    [ "rgb:B", "esp:7", "blue", [ "v0" ] ],
    [ "rgb:COM", "esp:GND.1", "black", [ "v0" ] ],

    [ "btn:1.l", "esp:0", "gray", [ "v0" ] ],
    [ "btn:2.l", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
